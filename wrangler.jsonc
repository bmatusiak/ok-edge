/*
 * The user's server (`npm run server:dev` runs it locally; the release workflow, .github/workflows/release.yml, builds
 * it onto the cloudflare branch, and Cloudflare deploys that branch on each push). mcp-server/src/index.js: the Worker - the identity rooms on /ws/<identity id> (a Durable Object each) and
 * the web app, built into docs/ and served as one page, so a reload on any route loads the app.
 *
 * The workflow builds the RELEASE export (mcp-server/build-webapp.js, CI set): a public URL never carries the testing
 * screen (metro.config.js swaps it for its stub when the bundle is not a dev one). It deploys from the cloudflare branch,
 * where tools/release/cloudflare-site.js writes this config without the build and with the Worker already bundled. A local run keeps the docs/ already built
 * (the box's --dev build: npm run build:webapp, tools/box/webapp.sh).
 *
 * run_worker_first: /ws/* and /mcp reach the Worker even though the single-page fallback would answer every path with
 * the app. Durable Objects: ROOMS (an identity's room), MCP_SESSIONS (one MCP session: which agent said hello), AGENTS
 * (one agent: its plans) - mcp-server/src/mcp.js.
 * new_sqlite_classes: the free plan's Durable Objects are the SQLite-backed kind.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ok-edge",
  "main": "mcp-server/src/index.js",
  "compatibility_date": "2026-10-23",
  "observability": { "enabled": true },
  /*
   * LIFETIME_IDENTITIES (mcp-server/src/index.js sealedLifetime) - the identities whose sealed copy is kept for good;
   * every other identity syncs too, on the free tier: its copy is dropped after 7 days without a touch (Brad,
   * 2026-10-30). Bucket identity ids, comma-separated, or * for all - a Worker SECRET (`npx wrangler secret put
   * LIFETIME_IDENTITIES`), not a var here. Cloudflare builds and deploys the cloudflare branch on every push, from the
   * config written from this file, and a var here would replace the live value with this one on each deploy; a secret
   * is never touched by a deploy, and no identity id is in git. Unset: none is lifetime. Local dev: all (--var in
   * server:dev). SEALED_FREE_MS (optional) sets the free tier's window, for a test server.
   */
  "build": { "command": "node mcp-server/build-webapp.js" },
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws/*", "/mcp"]
  },
  "durable_objects": { "bindings": [
    { "name": "ROOMS", "class_name": "IdentityRoom" },
    { "name": "MCP_SESSIONS", "class_name": "McpSession" },
    { "name": "AGENTS", "class_name": "AgentSession" }
  ] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["IdentityRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["McpSession", "AgentSession"] }
  ]
}
