<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      ok-rn's launch background (its values/splash.xml): the app's own background, theme.bg in
      src/ui/theme.ts, so the hand-over to the animated splash changes nothing but the logo.
      drawable/splash_window draws the logo on it; app.plugin.js makes it the window background
      of Expo's splash theme. ok-rn's Theme.App.Starting is not here: it needs
      androidx.core:core-splashscreen, which ok-edge does not use.
    -->
    <color name="splash_background">#1a1a1a</color>
</resources>
