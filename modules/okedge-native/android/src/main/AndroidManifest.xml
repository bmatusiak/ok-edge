<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- NativeQrScanner: asked only when Scan is pressed; a phone without a camera still installs -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- NativeSecrets: BiometricPrompt over a Keystore key made with setUserAuthenticationRequired -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- NativeUsbHid: USB host mode over OTG. required=false so the app still installs on phones
         without host support; the app reports it at runtime. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- PressAlert, EdgeAlert and the computer link's service: notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- NativeFidoGatt: the computer link, a BLE peripheral (as ok-rn's manifest) -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <!-- Android 12+ split the old BLUETOOTH/BLUETOOTH_ADMIN grants apart -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Guest Book's key swap finds the other phone by its swap service only: never for location -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- pre-12, BLE work is gated behind location -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <!-- keeps the GATT server alive while a computer's session is open -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <application>
        <!-- foreground while the GATT server is up; connectedDevice is the Android 14 type for a
             Bluetooth peripheral. Started and stopped by NativeFidoGattModule with the server. -->
        <service
            android:name="com.okrn.fido.FidoGattService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- NativeShare: a staged backup handed to another app as a content:// URI -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_files" />
        </provider>

        <!-- an Edge alarm's Hold action: a broadcast, so it works from the lock screen; not
             exported, only this app's own notifications can send it -->
        <receiver
            android:name="com.okrn.emu.NativeEdgeAlertModule$HoldReceiver"
            android:exported="false" />

        <!-- the QR scanner's camera: same process, opened for a result -->
        <activity
            android:name="com.okrn.qr.QrScanActivity"
            android:exported="false"
            android:theme="@style/AppTheme"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true" />

        <!-- ==========  EXPERIMENT: Android Credential Manager (ok-rn's REMOVAL.md)  ==========
             exported with BIND_CREDENTIAL_PROVIDER_SERVICE is the required pair: visible so the
             system can bind it, and the permission stops anything BUT the system from doing so. -->
        <service
            android:name="com.okrn.credprovider.OkCredentialProviderService"
            android:exported="true"
            android:label="Onlykey App"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE"
            tools:targetApi="34">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/provider_config" />
        </service>
        <!-- launched by the system once the user picks OnlyKey. NOT its own process: a second
             process means a second ReactHost and a second okemu writing the same flash.bin. -->
        <activity
            android:name="com.okrn.credprovider.CredProviderActivity"
            android:exported="false"
            android:theme="@style/AppTheme"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTask" />

        <!-- NativeOkEmu's restart: the firmware's reboot starts a NEW process, from a helper
             in its own (see RestartActivity) - as in ok-rn's manifest -->
        <activity
            android:name="com.okrn.RestartActivity"
            android:process=":restart"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:exported="false" />

        <!-- Merged into the app's own activity (expo prebuild writes it as <applicationId>.MainActivity):
             brings the app forward when an OnlyKey is plugged in (res/xml/device_filter.xml), as
             ok-rn's manifest does. -->
        <activity android:name="${applicationId}.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>
    </application>
</manifest>
