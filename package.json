{
  "name": "ok-edge",
  "version": "0.0.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "web": "expo start --web --port 8090",
    "build:web": "expo export --platform web --output-dir dist/web",
    "electron": "node electron/start.js",
    "electron:dev": "cross-env OKEDGE_WEB_URL=http://localhost:8090 node electron/start.js",
    "build:electron": "npm run build:web && electron-builder --dir",
    "build:android": "expo prebuild --platform android --no-install && cd android && gradlew assembleRelease",
    "cli": "node node_modules/node-onlykey-lib/cli/index.js",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@bmatusiak/rectify": "github:bmatusiak/rectify#a0d9f0e6e537053122273b1f763ac87ae461361c",
    "@expo/metro-runtime": "~58.0.14",
    "events": "^3.3.0",
    "expo": "~58.0.16",
    "expo-dev-client": "~58.0.14",
    "expo-status-bar": "~58.0.3",
    "node-onlykey-lib": "github:bmatusiak/node-onlykey-lib#fd00d3c0f32213d42c443a0e96df42f7ce481cda",
    "okedge-native": "file:./modules/okedge-native",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "cross-env": "^10.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "~6.0.3"
  },
  "build": {
    "appId": "com.okedge.desktop",
    "productName": "ok-edge",
    "files": [
      "electron/**",
      "dist/web/**",
      "package.json",
      "!node_modules/**"
    ],
    "directories": {
      "output": "dist/electron"
    },
    "npmRebuild": false,
    "extraMetadata": {
      "main": "electron/main.js"
    }
  }
}
